# Local development env (copy to .env.local). DO NOT commit real values.
# Cloudflare Workers inject these as `platform.env.*` in production via `wrangler secret put`.

DATABASE_URL=file:./data/local.db
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openrouter/auto
SESSION_SECRET=replace-with-random-32-bytes
ADMIN_PASSWORD_HASH=replace-with-bcrypt-or-argon2-hash
