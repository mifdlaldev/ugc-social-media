# Local development env (copy to .env.local). DO NOT commit real values.
# Cloudflare Workers inject these as `platform.env.*` in production via `wrangler secret put`.

DATABASE_URL=file:./data/local.db

# Text LLM gateway (NaraRouter, OpenAI-compatible). Base URL defaults to
# https://router.bynara.id/v1 when LLM_BASE_URL is absent.
LLM_BASE_URL=https://router.bynara.id/v1
LLM_API_KEY=sk-nry-...
LLM_MODEL=replace-with-a-model-alias-your-plan-grants

SESSION_SECRET=replace-with-random-32-bytes
ADMIN_PASSWORD_HASH=replace-with-bcrypt-or-argon2-hash

# You.com search API (https://api.you.com) - required for research stage.
# Get a free key at https://you.com (free tier available).
YOU_API_KEY=replace-with-you-com-api-key